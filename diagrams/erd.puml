@startuml

entity "vehicle" as v {
        * **String : vehicleID <<PK>>**
        --
        * String : nickname
        String : make
        String : model
        Int : modelYear
        String : plate
}


entity "mileage" as m {
        * **String : mileageID <<PK>>**
        --
        * String : timestamp
        Double : latitude
        Double : longitude
        * Double : odometerMiles
        * Double : volumeGallons
        * Boolean : isFullTank
        * Enum : fuelType
        * Boolean : isTopTier
        * Double : totalDollars
        String : journal
        * boolean : isExported
        * **String : vehicle <<FK>>**
        ..
        <<unique>> (vehicle, timestamp)
}

entity "mileage_attachment" as ma {
        * **String : attachmentID <<PK>>**
        --
        * String : filepath
        * **String : mileage <<FK>>**
}

enum "fuelType" as ft {
        REGULAR
        PLUS
        PREMIUM
        E85
        DIESEL
}

v ||..o{ m
m ||..o{ ma

@enduml
